---
import { ClientRouter } from "astro:transitions";
import Sidebar from "./Sidebar.astro";
import "../styles/global.css";

interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — DMARC Viewer</title>
    <script is:inline>
      (function () {
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        document.documentElement.setAttribute("data-mode", mq.matches ? "dark" : "light");
        mq.addEventListener("change", function (e) {
          document.documentElement.setAttribute("data-mode", e.matches ? "dark" : "light");
        });
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-kumo-recessed text-kumo-default">
    <div class="flex min-h-screen">
      <Sidebar />
      <main class="flex-1 p-8 overflow-auto min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
