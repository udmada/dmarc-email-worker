---
import { ClientRouter } from "astro:transitions";
import Sidebar from "./Sidebar.astro";
import "../styles/global.css";

interface Props { title: string; }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — DMARC Viewer</title>
    <script is:inline>
      (function () {
        function applyMode() {
          var dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.setAttribute("data-mode", dark ? "dark" : "light");
        }
        applyMode();
        window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", applyMode);
        document.addEventListener("astro:after-swap", applyMode);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class="bg-kumo-recessed text-kumo-default">
    <div class="flex min-h-screen">
      <Sidebar />
      <main class="flex-1 p-8 overflow-auto min-w-0">
        <slot />
      </main>
    </div>
  </body>
</html>
