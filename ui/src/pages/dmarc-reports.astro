---
import { Surface } from "@cloudflare/kumo";
import { env } from "cloudflare:workers";
import Layout from "../components/Layout.astro";
import { FilterBar } from "../components/FilterBar.tsx";
import { DonutChart } from "../components/DonutChart.tsx";
import { formatDate, getDmarcAlignmentStats, getDmarcReports, totalPages } from "../lib/db";

const db = env.DB;
const url = Astro.url;

const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1", 10) || 1);
const domain = url.searchParams.get("domain") ?? undefined;
const fromParam = url.searchParams.get("from");
const toParam = url.searchParams.get("to");
const fromUnix = fromParam != null ? Math.floor(new Date(fromParam).getTime() / 1000) : NaN;
const toUnix = toParam != null ? Math.floor(new Date(toParam).getTime() / 1000) : NaN;
const from = isNaN(fromUnix) ? undefined : fromUnix;
const to = isNaN(toUnix) ? undefined : toUnix;

const [{ rows, total, pageSize }, alignment] = await Promise.all([
  getDmarcReports(db, page, domain, from, to),
  getDmarcAlignmentStats(db, domain, from, to),
]);
const pages = totalPages(total, pageSize);

const dkimPct = alignment.total > 0 ? Math.round((alignment.dkimAligned / alignment.total) * 100) : 0;
const spfPct = alignment.total > 0 ? Math.round((alignment.spfAligned / alignment.total) * 100) : 0;
const dmarcPct = alignment.total > 0 ? Math.round((alignment.dmarcAligned / alignment.total) * 100) : 0;

function pageUrl(p: number): string {
  const params = new URLSearchParams(url.searchParams);
  params.set("page", String(p));
  return `/dmarc-reports?${params}`;
}

function policyClass(p: string): string {
  if (p === "reject") return "text-kumo-danger font-medium";
  if (p === "quarantine") return "text-amber-600 font-medium";
  return "text-kumo-subtle";
}
---

<Layout title="DMARC Reports">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-kumo-default">DMARC Reports</h1>
    <p class="text-sm text-kumo-subtle mt-1">{total} reports total</p>
  </div>

  <!-- Filters -->
  <FilterBar domain={domain} from={fromParam ?? undefined} to={toParam ?? undefined} baseUrl="/dmarc-reports" client:load />

  <!-- Alignment charts -->
  <Surface className="p-6 mb-6">
    <div class="flex flex-wrap gap-10 justify-around">
      <DonutChart value={dkimPct} label="DKIM Aligned" sublabel={`${alignment.dkimAligned.toLocaleString()} / ${alignment.total.toLocaleString()} emails`} color="var(--color-kumo-success)" />
      <DonutChart value={spfPct} label="SPF Aligned" sublabel={`${alignment.spfAligned.toLocaleString()} / ${alignment.total.toLocaleString()} emails`} color="var(--color-kumo-brand)" />
      <DonutChart value={dmarcPct} label="DMARC Aligned" sublabel={`${alignment.dmarcAligned.toLocaleString()} / ${alignment.total.toLocaleString()} emails`} color="var(--color-kumo-link)" />
    </div>
  </Surface>

  <!-- Table -->
  <Surface className="overflow-hidden">
    <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="border-b border-kumo-line">
          <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Report ID</th>
          <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Domain</th>
          <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Org</th>
          <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Begin Date</th>
          <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Policy</th>
          <th class="px-4 py-3 sr-only">Actions</th>
        </tr>
      </thead>
      <tbody>
        {rows.length === 0 ? (
          <tr>
            <td colspan="6" class="text-center py-8 text-kumo-inactive">No reports found.</td>
          </tr>
        ) : (
          rows.map((r) => (
            <tr class="border-b border-kumo-line last:border-b-0 hover:bg-kumo-tint transition-colors">
              <td class="px-4 py-3 font-mono text-xs text-kumo-subtle max-w-48 truncate" title={r.report_id}>
                {r.report_id}
              </td>
              <td class="px-4 py-3 font-mono text-sm text-kumo-default">{r.domain}</td>
              <td class="px-4 py-3 text-sm text-kumo-subtle">{r.org_name}</td>
              <td class="px-4 py-3 text-sm text-kumo-subtle">{formatDate(r.begin_date)}</td>
              <td class="px-4 py-3 text-sm capitalize">
                <span class={policyClass(r.policy_p)}>{r.policy_p}</span>
              </td>
              <td class="px-4 py-3">
                <a
                  href={`/dmarc-reports/${r.report_id}`}
                  class="text-sm text-kumo-link hover:text-kumo-link/70 transition-colors"
                >
                  View <span aria-hidden="true">→</span>
                </a>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
    </div>
  </Surface>

  <!-- Pagination -->
  {pages > 1 && (
    <div class="flex justify-center mt-6 gap-1 flex-wrap">
      {page > 1 && (
        <a href={pageUrl(page - 1)} class="inline-flex items-center gap-1 px-3 py-1.5 text-sm rounded-md border border-kumo-line text-kumo-default hover:bg-kumo-recessed transition-colors">
          <span aria-hidden="true">←</span> Prev
        </a>
      )}
      {Array.from({ length: pages }, (_, i) => i + 1).map((p) => (
        <a
          href={pageUrl(p)}
          class={`inline-flex items-center px-3 py-1.5 text-sm rounded-md transition-colors ${
            p === page
              ? "bg-kumo-contrast text-kumo-inverse"
              : "border border-kumo-line text-kumo-default hover:bg-kumo-recessed"
          }`}
        >{p}</a>
      ))}
      {page < pages && (
        <a href={pageUrl(page + 1)} class="inline-flex items-center gap-1 px-3 py-1.5 text-sm rounded-md border border-kumo-line text-kumo-default hover:bg-kumo-recessed transition-colors">
          Next <span aria-hidden="true">→</span>
        </a>
      )}
    </div>
  )}
</Layout>
