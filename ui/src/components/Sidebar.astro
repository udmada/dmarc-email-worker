---
const links = [
  { href: "/dashboard", label: "Dashboard" },
  { href: "/dmarc-reports", label: "DMARC Reports" },
  { href: "/tls-reports", label: "TLS Reports" },
];
const current = Astro.url.pathname;
---
<aside class="w-56 peer-checked/sidebar:w-12 shrink-0 min-h-screen bg-kumo-recessed border-r border-kumo-line flex flex-col overflow-hidden transition-[width] duration-200">
  <div class="h-14 border-b border-kumo-line flex items-center shrink-0">
    <label
      for="sidebar-collapsed"
      class="shrink-0 w-12 h-14 flex items-center justify-center cursor-pointer hover:bg-kumo-tint text-kumo-subtle select-none text-base"
      title="Toggle sidebar"
    >☰</label>
    <span class="font-semibold text-sm text-kumo-default tracking-tight truncate pr-4">DMARC Viewer</span>
  </div>
  <nav class="flex-1 p-2 flex flex-col gap-1">
    {links.map((link) => (
      <a
        href={link.href}
        title={link.label}
        class:list={[
          "flex items-center px-3 py-2 rounded-md text-sm transition-colors whitespace-nowrap",
          current.startsWith(link.href)
            ? "bg-kumo-tint text-kumo-default font-medium"
            : "text-kumo-subtle hover:bg-kumo-tint hover:text-kumo-default",
        ]}
      >
        {link.label}
      </a>
    ))}
  </nav>
</aside>
