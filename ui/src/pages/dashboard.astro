---
import { Badge, Surface } from "@cloudflare/kumo";
import { env } from "cloudflare:workers";
import Layout from "../components/Layout.astro";
import { formatDate, getDashboardStats, getRecentDmarcReports } from "../lib/db";

const db = env.DB;
const [stats, recent] = await Promise.all([
  getDashboardStats(db),
  getRecentDmarcReports(db, 10),
]);

function policyVariant(p: string): "destructive" | "outline" | "secondary" {
  if (p === "reject") return "destructive";
  if (p === "quarantine") return "outline";
  return "secondary";
}
---

<Layout title="Dashboard">
  <div class="mb-6">
    <h1 class="text-2xl font-semibold text-kumo-default">Overview</h1>
    <p class="text-sm text-kumo-subtle mt-1">DMARC & TLS-RPT report summary</p>
  </div>

  <!-- Stat cards -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <Surface className="p-5">
      <p class="text-xs text-kumo-subtle uppercase tracking-wide">DMARC Reports</p>
      <p class="text-3xl font-bold text-kumo-brand mt-1">{stats.dmarcThisMonth}</p>
      <p class="text-xs text-kumo-inactive mt-1">this month</p>
    </Surface>
    <Surface className="p-5">
      <p class="text-xs text-kumo-subtle uppercase tracking-wide">TLS Reports</p>
      <p class="text-3xl font-bold text-kumo-link mt-1">{stats.tlsThisMonth}</p>
      <p class="text-xs text-kumo-inactive mt-1">this month</p>
    </Surface>
    <Surface className="p-5">
      <p class="text-xs text-kumo-subtle uppercase tracking-wide">DKIM Pass Rate</p>
      <p class="text-3xl font-bold text-kumo-success mt-1">{stats.dkimPassRate}%</p>
      <p class="text-xs text-kumo-inactive mt-1">all time</p>
    </Surface>
    <Surface className="p-5">
      <p class="text-xs text-kumo-subtle uppercase tracking-wide">SPF Pass Rate</p>
      <p class="text-3xl font-bold text-kumo-success mt-1">{stats.spfPassRate}%</p>
      <p class="text-xs text-kumo-inactive mt-1">all time</p>
    </Surface>
  </div>

  <!-- Recent activity -->
  <Surface className="overflow-hidden">
    <div class="flex items-center justify-between px-6 py-4 border-b border-kumo-line">
      <h2 class="font-semibold text-kumo-default">Recent DMARC Reports</h2>
      <a href="/dmarc-reports" class="text-sm text-kumo-link hover:text-kumo-link/70 transition-colors">
        View all <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="border-b border-kumo-line">
            <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Domain</th>
            <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Org</th>
            <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Date</th>
            <th class="px-4 py-3 text-sm font-semibold text-kumo-default">Policy</th>
            <th class="px-4 py-3 sr-only">Actions</th>
          </tr>
        </thead>
        <tbody>
          {recent.length === 0 ? (
            <tr>
              <td colspan="5" class="text-center py-8 text-kumo-inactive">No reports yet.</td>
            </tr>
          ) : (
            recent.map((r) => (
              <tr class="border-b border-kumo-line last:border-b-0 hover:bg-kumo-tint transition-colors">
                <td class="px-4 py-3 font-mono text-sm text-kumo-default">{r.domain}</td>
                <td class="px-4 py-3 text-sm text-kumo-subtle">{r.org_name}</td>
                <td class="px-4 py-3 text-sm text-kumo-subtle">{formatDate(r.begin_date)}</td>
                <td class="px-4 py-3 text-sm capitalize">
                  <Badge variant={policyVariant(r.policy_p)}>{r.policy_p}</Badge>
                </td>
                <td class="px-4 py-3">
                  <a
                    href={`/dmarc-reports/${r.report_id}`}
                    class="text-sm text-kumo-link hover:text-kumo-link/70 transition-colors"
                  >
                    View <span aria-hidden="true">→</span>
                  </a>
                </td>
              </tr>
            ))
          )}
        </tbody>
      </table>
    </div>
  </Surface>
</Layout>
